<Window x:Class="DeltaPlayer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾音 · 乐器播放器" Width="760" Height="590" MinWidth="620" MinHeight="530" Background="#F4F6F3" Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <ScrollViewer x:Name="Viewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="ViewportChanged">
  <Grid x:Name="Layout" Margin="32,24">
    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="拾音" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="乐器播放器" Foreground="{StaticResource Muted}" Margin="14,7,0,0" FontSize="12" /></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="OpenTop" Content="打开曲谱" Click="OpenClick" Visibility="Collapsed" Margin="0,0,10,0" /><Button Content="使用帮助" Click="HelpClick" Padding="10,8" Background="Transparent" BorderThickness="0" /></StackPanel>
    </Grid>
    <Border Grid.Row="1" MinHeight="280" Background="White" BorderBrush="#E0E6E2" BorderThickness="1" CornerRadius="14" Margin="0,20,0,18" Padding="28">
      <Grid>
        <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="一首曲子，就从这里开始" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,14" />
          <TextBlock Text="打开曲谱，听一下，再带进游戏。" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,28" />
          <Button x:Name="OpenEmpty" Content="打开曲谱" Style="{StaticResource Primary}" Click="OpenClick" Width="150" />
          <TextBlock Text="也可以拖入 MIDI 或 TXT 文件" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
        <Grid x:Name="SongPanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="当前曲目" FontSize="12" Foreground="{StaticResource Muted}" /><TextBlock x:Name="SongTitle" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
          <Canvas x:Name="Contour" Grid.Row="1" Height="48" Margin="0,22,0,22" VerticalAlignment="Center" ClipToBounds="True" SizeChanged="ContourChanged" />
          <StackPanel Grid.Row="2"><ProgressBar x:Name="Progress" Height="4" Background="#E8EEEA" Foreground="{StaticResource Accent}" BorderThickness="0" Maximum="1" /><TextBlock x:Name="TimeLabel" Text="00:00 / 00:00" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,20" /></StackPanel>
          <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal"><Button x:Name="PreviewButton" Content="试听" Click="PreviewClick" MinWidth="88" Margin="0,0,10,0" /><Button x:Name="PlayButton" Content="播放" Style="{StaticResource Primary}" Click="PlayClick" MinWidth="120" Margin="0,0,10,0" /><Button x:Name="StopButton" Content="停止" Click="StopClick" MinWidth="80" /></StackPanel>
            <Button x:Name="VoiceToggle" Content="换个声部" Click="VoiceClick" HorizontalAlignment="Right" Padding="8,10" Background="Transparent" BorderThickness="0" />
          </Grid>
        </Grid>
      </Grid>
    </Border>
    <StackPanel Grid.Row="2">
      <StackPanel x:Name="VoicePanel" Visibility="Collapsed" Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="试听不同声部" VerticalAlignment="Center" Margin="0,0,12,0" /><ComboBox x:Name="Voices" MinWidth="210" MaxWidth="350" SelectionChanged="VoiceChanged" DisplayMemberPath="Name" /></StackPanel>
      <Expander x:Name="Options" Header="播放选项" Foreground="{StaticResource Muted}" Visibility="Collapsed" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,10,0,4"><TextBlock Text="速度" VerticalAlignment="Center" Margin="0,0,16,0" /><ComboBox x:Name="Speed" Width="130" SelectionChanged="SpeedChanged"><ComboBoxItem Content="慢一点" /><ComboBoxItem Content="原速" /><ComboBoxItem Content="快一点" /></ComboBox><Button Content="恢复默认" Click="ResetSpeed" Padding="10,6" Margin="10,0,0,0" Background="Transparent" BorderThickness="0" /></StackPanel>
      </Expander>
      <StackPanel x:Name="TargetPanel" Visibility="Collapsed" Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="选择游戏窗口" VerticalAlignment="Center" Margin="0,0,12,0" /><ComboBox x:Name="Targets" Width="320" /></StackPanel>
      <TextBlock x:Name="Status" Text="曲谱只保存在本机。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" MinHeight="22" />
      <Button x:Name="AdminButton" Content="以管理员身份重启" Click="AdminRestartClick" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,6" />
      <Button x:Name="PartialButton" Content="仅试听／播放可演奏部分" Click="PartialClick" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,6" />
      <Button x:Name="RetryButton" Content="重试释放" Click="RetryClick" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,10,0,0" />
      <Button x:Name="CancelImport" Content="取消读取" Click="StopClick" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,10,0,0" />
    </StackPanel>
    <Grid Grid.Row="3" Margin="0,18,0,0"><TextBlock x:Name="HotkeyText" Text="F8 播放／暂停     F9 停止" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" /><Button Content="复制诊断信息" Click="DiagnosticsClick" Padding="0,4" FontSize="11" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" /></Grid>
  </Grid>
  </ScrollViewer>
</Window>
